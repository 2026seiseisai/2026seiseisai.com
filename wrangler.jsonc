{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "2026seiseisaicom",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "2026seiseisaicom",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "kv_namespaces": [
    {
      "binding": "EXHIBITION_AWARD_VOTES",
      "id": "123fda36aaef4fc7b5fbbbbac80d4b9b",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
